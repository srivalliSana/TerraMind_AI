# Copy to .env and fill in. NEVER commit .env. Names only here, no secrets.

# NASA Earthdata (https://urs.earthdata.nasa.gov) - needed only for downloads.
# Catalog search works without credentials. Prefer a token:
EARTHDATA_TOKEN=
# Or username/password (not supported for federated-identity accounts):
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional overrides
TERRAMIND_DATA_DIR=data
TERRAMIND_LOG_LEVEL=INFO
TERRAMIND_DB_PATH=data/terramind.sqlite
